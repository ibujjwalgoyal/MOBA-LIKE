include "hero_state.fbs";
include "entity_state.fbs";
include "game_event.fbs";

namespace moba;

table DeltaSnapshot {
  tick: uint32;
  ack_input_tick: uint32;
  heroes: [HeroState];
  creeps: [CreepState];
  towers: [TowerState];
  projectiles: [ProjectileState];
  events: [GameEvent];      // union vector
}