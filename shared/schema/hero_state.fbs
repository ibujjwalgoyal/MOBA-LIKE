namespace moba;

table HeroState {
  entity_id: uint32;
  team: uint8;            // 0 = Radiant, 1 = Dire
  pos_x: int32;           // fixed-point, scale 1000
  pos_y: int32;
  velocity_x: int32;      // fixed-point
  velocity_y: int32;
  health: int32;          // fixed-point
  max_health: int32;
  mana: int32;
  max_mana: int32;
  level: uint16;
  gold: int32;            // fixed-point (can be used for reliable gold display)
  status_effects: uint64; // bitmask of status effect IDs (32 bits enough? use uint64 for future)
  is_alive: bool;
}